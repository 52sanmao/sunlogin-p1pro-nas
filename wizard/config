[
  {
    "stepTitle": "连接设置",
    "items": [
      {
        "type": "text",
        "field": "wizard_host",
        "label": "插座 IP 地址",
        "rules": [
          { "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$", "message": "IP 格式不对，例如 192.168.0.15" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_device_port",
        "label": "插座端口",
        "rules": [
          { "pattern": "^[0-9]{1,5}$", "message": "端口只能是数字" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_access_token",
        "label": "面板访问密码"
      },
      {
        "type": "tips",
        "helpText": "留空的项保持当前设置不变，保存后面板会自动重启，历史数据不受影响。"
      },
      {
        "type": "tips",
        "helpText": "访问密码也可以随时在面板右上角的「设置」里修改或清除，那里还能调电价、采样间隔和额定功率。"
      }
    ]
  }
]
